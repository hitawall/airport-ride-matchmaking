# Neon Postgres (provisioned via Vercel Marketplace; pulled automatically with `vercel env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
JWT_SECRET=

# MSG91 (phone OTP)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Google Maps Platform (Geocoding + Places, consumed by the Flutter app directly;
# not currently called from this backend, listed here for completeness)
GOOGLE_MAPS_API_KEY=

# Pusher Channels (chat realtime)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Vercel Blob (profile photos; provisioned via Vercel Marketplace)
BLOB_READ_WRITE_TOKEN=

# Internal cron protection (Vercel Cron -> /api/internal/ride-requests/sweep)
CRON_SECRET=

# CORS: the deployed web app's origin
WEB_APP_ORIGIN=
