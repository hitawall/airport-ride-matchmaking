# Neon Postgres (provisioned via Vercel Marketplace; pulled automatically with `vercel env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
JWT_SECRET=

# Resend (email OTP)
RESEND_API_KEY=
OTP_FROM_EMAIL=

# App-store review account (optional): one email that logs in with a fixed code so
# Google/Apple reviewers can get past the email OTP. Leave both unset to disable.
# The code must be exactly 6 digits (not 000000). See docs/STORE_REVIEW_ACCOUNT.md.
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_CODE=

# Google Maps Platform (Geocoding + Places, consumed by the Flutter app directly;
# not currently called from this backend, listed here for completeness)
GOOGLE_MAPS_API_KEY=

# Pusher Channels (chat realtime)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Vercel Blob (profile photos; provisioned via Vercel Marketplace)
BLOB_READ_WRITE_TOKEN=

# Internal cron protection (Vercel Cron -> /api/internal/ride-requests/sweep)
CRON_SECRET=

# Moderation (see docs/MODERATION.md). Both optional.
# Where the daily digest of new reports is emailed (needs RESEND_API_KEY and OTP_FROM_EMAIL working).
MODERATION_EMAIL=
# Long random token (24+ characters, different from CRON_SECRET) that allows moderator actions.
MODERATION_TOKEN=

# CORS: the deployed web app's origin
WEB_APP_ORIGIN=
